# ~/.config/ghostty/config

# ─────────────────────────────────────────
# APPEARANCE
# ─────────────────────────────────────────
config-file = ?auto/theme.ghostty
font-family = "JetBrainsMono Nerd Font"
font-size = 10
font-thicken = true
font-feature = liga
bold-is-bright = true

background-opacity = 0.8
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# This removes the title bar and borders on launch
window-decoration = false
cursor-style = bar
cursor-style-blink = true

# ─────────────────────────────────────────
# BEHAVIOUR
# ─────────────────────────────────────────
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 10000
confirm-close-surface = false
link-url = true

clipboard-read = allow
clipboard-write = allow

shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-terminfo

split-inherit-working-directory = true
tab-inherit-working-directory = true

gtk-single-instance = false
quit-after-last-window-closed-delay = 5m

# ─────────────────────────────────────────
# QUICK TERMINAL & SHADERS
# ─────────────────────────────────────────
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true

custom-shader = shaders/blaze.glsl
custom-shader-animation = always
fullscreen = true

# ─────────────────────────────────────────
# KEYBINDINGS
# ─────────────────────────────────────────

# SPLITS & TABS
keybind = ctrl+shift+9=new_split:right
keybind = ctrl+shift+0=new_split:down
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface

keybind = ctrl+tab=goto_split:next
keybind = ctrl+shift+tab=goto_split:previous
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom

keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+shift+page_up=move_tab:-1
keybind = ctrl+shift+page_down=move_tab:1

keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# SCROLLING
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom
keybind = shift+up=scroll_page_lines:-3
keybind = shift+down=scroll_page_lines:3

# FONT SIZE
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# MISC
keybind = ctrl+shift+comma=reload_config
keybind = ctrl+f11=toggle_quick_terminal
keybind = ctrl+shift+f11=toggle_window_decorations
keybind = ctrl+shift+i=inspector:toggle
